# THUNAI uses OpenRouter only for cloud AI. Choose a FREE multimodal model.
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_VISION_MODEL="google/gemma-4-26b-a4b-it:free"
OPENROUTER_TEXT_MODEL="google/gemma-4-26b-a4b-it:free"

# Gemini API - Primary AI for voice conversations
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_MS=6000

# Twilio Configuration (Optional - for Emergency SMS/WhatsApp)
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
EMERGENCY_CONTACT_PHONE="+918939517847"

# App URL used for OpenRouter request metadata.
APP_URL="http://localhost:4000"
